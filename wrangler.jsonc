// La web de HORIZON RCRDS en Cloudflare (cuenta "Horizon Records").
// Publicar:  node worker/wrangler.mjs deploy   (usa la sesión de Cloudflare de Horizon, la del bot)
{
  "name": "horizon-web",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "horizonrcrds.com", "custom_domain": true },
    { "pattern": "www.horizonrcrds.com", "custom_domain": true }
  ],
  "build": { "command": "node worker/build.mjs" },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Estas rutas pasan siempre por el servidor: datos, API y archivos que el panel puede sustituir
    "run_worker_first": ["/api/*", "/releases.json", "/mixtapes.json", "/playlists.json", "/sync-ignore.json", "/assets/release_preview.mp3", "/assets/logo.png", "/assets/favicon_icon.png"]
  },
  "vars": {
    // ID de cliente de Google (público). Los emails de los owners van como secreto (OWNER_EMAILS).
    "GOOGLE_CLIENT_ID": "157268274335-7oct5ose15hu5c9dhq1bh2fem0dnden0.apps.googleusercontent.com",
    "SYNC_REPO": "JayHertzmusic/horizon-rcrds",
    // Remitente de los correos de contratos; las respuestas de los artistas llegan a MAIL_TO (Gmail de Horizon)
    "MAIL_FROM": "contracts@horizonrcrds.com",
    "MAIL_TO": "contacthorizonids@gmail.com",
    // Correos de contratos a los artistas: Resend (gratis), clave en el secreto RESEND_API_KEY
    // Script de Google de Horizon (aplicación web): da al servidor el permiso de Google Docs/Drive de la cuenta de Horizon
    // (solo responde con la clave GFORM_SECRET)
    "GSCRIPT_URL": "https://script.google.com/macros/s/AKfycbx0olV05UBMEDQa6OSkmIdDP8X05DhJdsEqYsfgTG2brDf0VFiLAa9PShqlJUYTYT2R/exec"
  },
  "send_email": [{ "name": "MAIL", "destination_address": "contacthorizonids@gmail.com" }],
  // fotos de SoundCloud del equipo: se miran cada 30 minutos
  "triggers": { "crons": ["*/30 * * * *", "15,45 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "horizon-web", "database_id": "a9514982-6bf4-47ad-8181-cd95caf3df46" }],
  "kv_namespaces": [{ "binding": "FILES", "id": "f2ce183033764564beb769fcb97505bc" }],
  "observability": { "enabled": true }
}
